---
import AppLayout from '../layouts/AppLayout.astro';
import { DashboardSummary } from '../islands/DashboardSummary';
import { ChoreSummary } from '../islands/ChoreSummary';
---

<AppLayout title="Dashboard">
  <div class="page-header">
    <h1>Dashboard</h1>
  </div>
  <section class="card" aria-labelledby="household-heading">
    <h2 id="household-heading">Your household</h2>
    <DashboardSummary client:load />
  </section>
  <section class="card" aria-labelledby="chores-heading">
    <h2 id="chores-heading">Chores</h2>
    <ChoreSummary client:load />
  </section>
  <section class="card placeholder-card" aria-labelledby="later-heading">
    <h2 id="later-heading">Coming later</h2>
    <p>Shopping lists, household projects, and home maintenance are outside this phase.</p>
  </section>
</AppLayout>

