---
import AppLayout from '../../layouts/AppLayout.astro';
import { ChoreForm } from '../../islands/ChoreForm';
---

<AppLayout title="Edit chore">
  <div class="page-header">
    <h1>Edit chore</h1>
  </div>
  <section class="card" aria-labelledby="chore-form-heading">
    <h2 id="chore-form-heading">Chore details</h2>
    <!-- The chore id comes from ?id=, read by the island, so this page stays static. -->
    <ChoreForm mode="edit" client:load />
  </section>
</AppLayout>
