{
  "name": "homebase-app",
  "version": "1.0.0",
  "private": true,
  "description": "HomeBase is a household organization web application designed to help families, couples, and roommates keep track of shared responsibilities in one place.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
