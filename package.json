{
  "name": "homebase-astro",
  "version": "0.1.0",
  "private": true,
  "description": "HomeBase rebuilt on Astro for Bakeoff 2: static prerendering, React islands, and REST API endpoints.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "prisma generate && astro build",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "license": "ISC",
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@astrojs/react": "^7.1.2",
    "@nanostores/react": "^2.0.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "astro": "^7.4.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.8",
    "nanostores": "^1.5.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^7.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
